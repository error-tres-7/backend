# On Railway, reference the MySQL service instead of copying values:
# MYSQLHOST=${{MySQL.MYSQLHOST}} etc.
MYSQLHOST=127.0.0.1
MYSQLPORT=3306
MYSQLUSER=root
MYSQLPASSWORD=
MYSQLDATABASE=plataforma_mercados

# Comma-separated frontend origins allowed to call with the session cookie.
ALLOWED_ORIGINS=https://entrepuestos.com,https://www.entrepuestos.com
# Leading dot shares the cookie between entrepuestos.com and api.entrepuestos.com.
SESSION_DOMAIN=.entrepuestos.com
# Set to false only for local http.
SESSION_SECURE=true
